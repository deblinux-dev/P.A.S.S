diff --git a/tests/t_vdir15.S b/tests/t_vdir15.S
new file mode 100644
index 0000000..24ce104
--- /dev/null
+++ b/tests/t_vdir15.S
@@ -0,0 +1,105 @@
+# t_vdir15.S — дифференциальный тест VF_DIR (vmovdqa/vmovdqu) во всех
+# комбинациях с xmm15/ymm15: носитель клиента обязан сохранять app-значение
+# и переносить lo+hi без искажений (B-2006/B-2007 regression).
+# src==ymm15 (B-2007: lo читается ДО затирания носителем), dst==ymm15,
+# обычные reg-reg, no-op, store ymm15->mem, load mem->ymm15.
+.text
+.global _start
+_start:
+    lea msg(%rip), %rbx
+    mov $0, %r15d
+
+    /* 1. src==ymm15: ymm2 <- ymm15 (верх ymm2 предзаполнен мусором) */
+    vmovdqu tB(%rip), %ymm2
+    vmovdqu tA(%rip), %ymm15
+    vmovdqa %ymm15, %ymm2
+    vmovdqu %xmm2, %xmm0
+    call hash                     # lo ymm2
+    vextractf128 $1, %ymm2, %xmm0
+    call hash                     # hi ymm2
+    vmovdqu %xmm15, %xmm0
+    call hash                     # xmm15 инвариант (= tA.lo)
+
+    /* 2. dst==ymm15: ymm15 <- ymm1 */
+    vmovdqu tB(%rip), %ymm1
+    vmovdqa %ymm1, %ymm15
+    vmovdqu %xmm15, %xmm0
+    call hash                     # lo ymm15 = tB.lo
+    vextractf128 $1, %ymm15, %xmm0
+    call hash                     # hi ymm15 = tB.hi
+
+    /* 3. обычный reg-reg: ymm4 <- ymm3 (верх ymm4 предзаполнен) */
+    vmovdqu tB(%rip), %ymm4
+    vmovdqu tC(%rip), %ymm3
+    vmovdqa %ymm3, %ymm4
+    vmovdqu %xmm4, %xmm0
+    call hash
+    vextractf128 $1, %ymm4, %xmm0
+    call hash
+    vmovdqu %xmm15, %xmm0
+    call hash                     # инвариант
+
+    /* 4. no-op: ymm2 <- ymm2 */
+    vmovdqa %ymm2, %ymm2
+    vmovdqu %xmm2, %xmm0
+    call hash
+
+    /* 5. store ymm15 -> mem: буфер == tB, xmm15 не тронут */
+    vmovdqu tB(%rip), %ymm15
+    vmovdqu %ymm15, buf(%rip)
+    vmovdqu buf(%rip), %xmm0
+    call hash
+    vmovdqu buf+16(%rip), %xmm0
+    call hash
+    vmovdqu %xmm15, %xmm0
+    call hash
+
+    /* 6. load mem -> ymm15 */
+    vmovdqu tC(%rip), %ymm5
+    vmovdqu %ymm5, buf(%rip)
+    vmovdqu buf(%rip), %ymm15
+    vmovdqu %xmm15, %xmm0
+    call hash
+    vextractf128 $1, %ymm15, %xmm0
+    call hash
+
+    /* вывод */
+    mov $1, %eax
+    mov $1, %edi
+    lea msg(%rip), %rsi
+    mov %r15d, %edx
+    syscall
+    mov $60, %eax
+    xor %edi, %edi
+    syscall
+
+hash:
+    pushfq
+    pop %rax
+    movq %xmm0, %rcx
+    xor %rax, %rcx
+    mov %ecx, 0(%rbx,%r15,1)
+    shr $32, %rcx
+    mov %ecx, 4(%rbx,%r15,1)
+    add $8, %r15d
+    ret
+
+.section .rodata
+.align 32
+tA:     .quad 0x11AA11AA11AA11AA, 0x22BB22BB22BB22BB
+        .quad 0x33CC33CC33CC33CC, 0x44DD44DD44DD44DD
+        .quad 0x55EE55EE55EE55EE, 0x66FF66FF66FF66FF
+        .quad 0x7700770077007700, 0x8811881188118811
+tB:     .quad 0x9E3779B97F4A7C15, 0xBF58476D1CE4E5B9
+        .quad 0x94D049BB133111EB, 0xCAFEBABEDEADBEEF
+        .quad 0x0123456789ABCDEF, 0xFEDCBA9876543210
+        .quad 0xA5A5A5A5A5A5A5A5, 0x5C5C5C5C5C5C5C5C
+tC:     .quad 0x123456789ABCDEF0, 0x0FEDCBA987654321
+        .quad 0xDEADBEEFCAFEBABE, 0xAAAAAAAA55555555
+        .quad 0x1111222233334444, 0x5555666677778888
+        .quad 0x9999AAAABBBBCCCC, 0xDDDDEEEEFFFF0000
+.section .bss
+.align 32
+buf:    .space 64
+msg:
+    .space 512
diff --git a/tests/t_vextm.S b/tests/t_vextm.S
new file mode 100644
index 0000000..66e1897
--- /dev/null
+++ b/tests/t_vextm.S
@@ -0,0 +1,88 @@
+# t_vextm.S — дифференциальный тест VEXTRACTF128/VEXTRACTI128 с ПАМЯТЬЮ-
+# приёмником (B-2006: bun 1.2.14 -e — JIT-спил ymm в память падал в
+# ловушку UNENCODABLE: спил/восстановление xmm15 кодировался как OP_mov
+# с xmm-операндом вместо movups).
+# Формы: vextracti128 imm=1/imm=0, vextractf128 imm=1, mem-приёмник,
+# источник ymm15 (ветка s_is_15 — спил не выполняется). После каждой
+# операции хешируем буфер-приёмник И xmm15 (спил/восстановление обязан
+# сохранять xmm15 побайтно). Native vs PASS — вывод совпадает побайтно.
+.text
+.global _start
+_start:
+    lea msg(%rip), %rbx
+    mov $0, %r15d
+
+    /* 1. vextracti128 $1, %ymm1 -> mem (жирная форма из bun-JIT) */
+    vmovdqu t256(%rip), %ymm1
+    vextracti128 $1, %ymm1, buf(%rip)
+    vmovdqu buf(%rip), %xmm0
+    call hash
+    vmovdqu %xmm15, %xmm0
+    call hash
+
+    /* 2. vextracti128 $0, %ymm1 -> mem (младшая половина) */
+    vmovdqu t256b(%rip), %ymm1
+    vextracti128 $0, %ymm1, buf(%rip)
+    vmovdqu buf(%rip), %xmm0
+    call hash
+
+    /* 3. vextractf128 $1, %ymm2 -> mem */
+    vmovdqu t256(%rip), %ymm2
+    vextractf128 $1, %ymm2, buf(%rip)
+    vmovdqu buf(%rip), %xmm0
+    call hash
+
+    /* 4. источник ymm15: спил не нужен, но результат тот же */
+    vmovdqu t256b(%rip), %ymm15
+    vextracti128 $1, %ymm15, buf(%rip)
+    vmovdqu buf(%rip), %xmm0
+    call hash
+    vmovdqu %xmm15, %xmm0
+    call hash
+
+    /* 5. повторный вызов на ту же память (перезапись) */
+    vmovdqu t256(%rip), %ymm3
+    vextracti128 $1, %ymm3, buf(%rip)
+    vextractf128 $0, %ymm3, buf+16(%rip)
+    vmovdqu buf(%rip), %xmm0
+    call hash
+    vmovdqu buf+16(%rip), %xmm0
+    call hash
+
+    /* вывод: r15 байт */
+    mov $1, %eax
+    mov $1, %edi
+    lea msg(%rip), %rsi
+    mov %r15d, %edx
+    syscall
+    mov $60, %eax
+    xor %edi, %edi
+    syscall
+
+/* hash: eflags ^ low64(xmm0), 8 байт в msg */
+hash:
+    pushfq
+    pop %rax
+    movq %xmm0, %rcx
+    xor %rax, %rcx
+    mov %ecx, 0(%rbx,%r15,1)
+    shr $32, %rcx
+    mov %ecx, 4(%rbx,%r15,1)
+    add $8, %r15d
+    ret
+
+.section .rodata
+.align 32
+t256:   .quad 0x1111111111111111, 0x2222222222222222
+        .quad 0x3333333333333333, 0x4444444444444444
+        .quad 0x5555555555555555, 0x6666666666666666
+        .quad 0x7777777777777777, 0x88CCDDEEFF001234
+t256b:  .quad 0x9E3779B97F4A7C15, 0xBF58476D1CE4E5B9
+        .quad 0x94D049BB133111EB, 0xCAFEBABEDEADBEEF
+        .quad 0x0123456789ABCDEF, 0xFEDCBA9876543210
+        .quad 0xA5A5A5A5A5A5A5A5, 0x5C5C5C5C5C5C5C5C
+.section .bss
+.align 32
+buf:    .space 64
+msg:
+    .space 512
